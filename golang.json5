{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  description: 'Go projects. Use together with default.json5.',
  packageRules: [
    {
      // Renovate skips indirect Go dependencies by default; keep them current too
      matchManagers: ['gomod'],
      matchDepTypes: ['indirect'],
      enabled: true,
    },
    {
      // Keep go.mod/go.sum tidy and rewrite import paths on major updates
      matchManagers: ['gomod'],
      postUpdateOptions: ['gomodTidy', 'gomodUpdateImportPaths'],
    },
  ],
}
