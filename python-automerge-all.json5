{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  description: 'Automerge all updates, including majors and lock file maintenance, for Python dependencies.',
  packageRules: [
    {
      matchManagers: ['pep621', 'pip_requirements', 'poetry', 'pipenv', 'setup-cfg'],
      automerge: true,
    },
  ],
}
