{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  description: 'Automerge all updates, including majors and lock file maintenance, for Rust dependencies and the toolchain.',
  packageRules: [
    {
      matchManagers: ['cargo'],
      automerge: true,
    },
    {
      // Toolchain updates from the rust-toolchain.toml custom manager in rust.json5
      matchDatasources: ['github-releases'],
      matchDepNames: ['rust'],
      automerge: true,
    },
  ],
}
